# ==============================================================================
# APEX AEA (Autonomous Economic Agent) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` to configure the Apex AEA environment.
# In 'mock' mode, missing variables fall back to safe deterministic defaults.
# In 'testnet' or 'mainnet', real keys and RPC endpoints are strictly required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
DATABASE_PATH=./data/agent.db

# Network Mode: 'mock' | 'testnet' | 'mainnet'
# - mock: 100% offline simulation (for unit/integration tests and CI)
# - testnet: Base Sepolia (84532) + Polygon Amoy (80002)
# - mainnet: Base Mainnet (8453) + Polygon PoS Mainnet (137)
NETWORK_MODE=mock

# ------------------------------------------------------------------------------
# 2. Blockchain RPC Endpoints & Chain Configuration
# ------------------------------------------------------------------------------
# Base Network (Base Sepolia: 84532 / Base Mainnet: 8453)
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Polygon Network (Polygon Amoy: 80002 / Polygon Mainnet: 137)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# ------------------------------------------------------------------------------
# 3. Agent Wallet & Governance Whitelist
# ------------------------------------------------------------------------------
# 32-byte hex private key (with 0x prefix).
# Required in 'testnet' and 'mainnet'. In 'mock' mode, falls back to a deterministic dummy key.
PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mother Clan Wallet Address (for child agents sending 5% royalties on net profits)
MOTHER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# 4. Financial Capital & Metabolic Thresholds (USD)
# ------------------------------------------------------------------------------
INITIAL_CAPITAL_USD=50.00
TIER_GREEN_THRESHOLD=50.00
TIER_YELLOW_THRESHOLD=10.00
TIER_ORANGE_THRESHOLD=2.00
TIER_RED_THRESHOLD=0.00

# ------------------------------------------------------------------------------
# 5. Heartbeat Interval Timing (Milliseconds)
# ------------------------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_GREEN_MS=60000
HEARTBEAT_INTERVAL_YELLOW_MS=300000
HEARTBEAT_INTERVAL_ORANGE_MS=60000

# ------------------------------------------------------------------------------
# 6. Risk Management & Kelly Sizing
# ------------------------------------------------------------------------------
# Fractional Kelly multiplier (0.25 = Quarter-Kelly)
KELLY_FRACTION=0.25
# Hard bankroll ceiling (Constitution Article II: strictly <= 0.05 / 5%)
MAX_BANKROLL_BET_PERCENT=0.05

# ------------------------------------------------------------------------------
# 7. Revenue Engine 1: Polymarket Prediction Markets
# ------------------------------------------------------------------------------
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_API_KEY=mock-polymarket-api-key
POLYMARKET_API_SECRET=mock-polymarket-api-secret
POLYMARKET_API_PASSPHRASE=mock-polymarket-passphrase

# ------------------------------------------------------------------------------
# 8. Revenue Engine 2: x402 Micropayments Protocol
# ------------------------------------------------------------------------------
PORT_X402=4020
X402_PRICE_USDC=0.05
X402_SETTLEMENT_CHAIN=base

# ------------------------------------------------------------------------------
# 9. Revenue Engine 3: Bounties Scanner
# ------------------------------------------------------------------------------
GITHUB_TOKEN=mock-github-token
BOUNTIES_MIN_REWARD_USD=10.00

# ------------------------------------------------------------------------------
# 10. Darwinian Mitosis & Evolution
# ------------------------------------------------------------------------------
MITOSIS_CAPITAL_MULTIPLIER=3.0
ROYALTY_PERCENTAGE=0.05

# ------------------------------------------------------------------------------
# 11. LLM Reasoning Providers (Inference mode free | paid, deterministic fallback)
# ------------------------------------------------------------------------------
# Inference mode: 'free' | 'paid'. In 'free', the provider queue runs local or
# free-tier models (e.g. Ollama) and no EXPENSE_LLM is booked. In 'paid', hosted
# providers with keys are used and EXPENSE_LLM is booked only when cost is reported.
INFERENCE_MODE=free
# Max LLM inference calls allowed per tick (deterministic estimator is the last degrau)
INFERENCE_CAP_PER_TICK=5
# Ordered provider queue as a JSON array. Keep empty until a free provider and its
# operating limits have been selected. Example entries can be added by the operator.
INFERENCE_PROVIDERS=[]
ANTHROPIC_API_KEY=mock-anthropic-key
OPENAI_API_KEY=mock-openai-key
GEMINI_API_KEY=mock-gemini-key

# ------------------------------------------------------------------------------
# 12. Mock & Simulation Controls (Active only when NETWORK_MODE=mock)
# ------------------------------------------------------------------------------
USE_MOCK_APIS=true
MOCK_WALLET_BALANCE_USD=75.00
MOCK_SIMULATE_ERRORS=false

# ------------------------------------------------------------------------------
# 13. Mission Control (Read-only Dashboard)
# ------------------------------------------------------------------------------
# Separate observer process: `npm run dashboard` (README section 10).
# Reuses DATABASE_PATH from section 1, always opened with readOnly: true.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7070
# Required whenever DASHBOARD_HOST is not 127.0.0.1 / localhost / ::1.
# Accepted as `Authorization: Bearer <token>` or `?token=<token>`.
# DASHBOARD_TOKEN=change-me
# Path to the Permadeath snapshot rendered in the Clan screen.
# TOMBSTONE_PATH=./tombstone.json
